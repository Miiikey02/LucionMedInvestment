# 复制为 .env（本地或服务器运行 server.mjs 时）；部署到 Cloudflare 时用 wrangler secret 设置同名变量。
# .env 不要提交到 GitHub。

# ---- 模型 ----
# LLM_PROVIDER=openai 适用于所有 OpenAI 兼容接口（DeepSeek、通义千问、Kimi、智谱等）
# LLM_PROVIDER=anthropic 使用 Claude（Anthropic Messages API）
LLM_PROVIDER=openai
LLM_API_KEY=

# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# 通义千问：LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# Kimi：    LLM_BASE_URL=https://api.moonshot.cn/v1                         LLM_MODEL=kimi-k2-turbo-preview
# 智谱：    LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4                LLM_MODEL=glm-4.6
# Claude：  LLM_PROVIDER=anthropic  LLM_BASE_URL=https://api.anthropic.com  LLM_MODEL=claude-opus-5-5  LLM_EFFORT=medium

# ---- 联网搜索（可选）----
# SEARCH_PROVIDER=bocha（博查，国内可用）或 tavily
SEARCH_PROVIDER=
SEARCH_API_KEY=

# ---- 访问控制 ----
# 同事在网页里第一次使用 AI 时输入的访问码，防止 API Key 被外人滥用
ACCESS_CODE=
# 允许调用网关的网站来源，多个用逗号分隔，例如 https://yourname.github.io
ALLOWED_ORIGINS=*

PORT=8787
